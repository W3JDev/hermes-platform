# ── Ports & Public Routing (Dokploy / Coolify / Local) ────────────────────────
FRONTDOOR_PORT=8888
COMPANION_PORT=8088
GATEWAY_PORT=8642
DASHBOARD_PORT=9119
ENTERPRISE_PORT=8001
BASE_DOMAIN=hermes.example.com

# ── Workspace & Engine Mode ──────────────────────────────────────────────────
# Use 'sample' for local offline testing, or 'live' with an access key in production
WORKSPACE_MODE=sample
AGENT_BACKEND=hermes

# ── LLM API Keys (Nous Hermes & OpenMuse) ─────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ── Real-Time Voice Synthesis (MiniMax & Grok) ────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_GROUP_ID=

# ── OpenComputer / Boat.dev Browser Automation ─────────────────────────────────
OPENCOMPUTER_API_KEY=
OPENCOMPUTER_PROJECT_ID=
WORKER_TOKEN=openmuse-worker-secure-token-32chars

# ── Hermes Dashboard Auth (Required for remote / non-localhost access) ────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=hermes-admin-2026

# ── Messenger Gateways (Optional) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=

# ── Database & Cache Secrets ─────────────────────────────────────────────────
POSTGRES_PASSWORD=hermes-secure-db-secret-change-me
POSTGRES_PORT=5435
REDIS_PORT=6382
JWT_SECRET_KEY=hermes-super-secret-jwt-key-minimum-32-chars-long

# ── Admin Account ────────────────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=hermes-admin-2026
